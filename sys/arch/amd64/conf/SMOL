include "arch/amd64/conf/MICROVM"
include "arch/x86/conf/files.tslog"

# debug instrumentation for the vioinput click-wedge investigation
# (no options DDB: this fork's sys/ddb lacks db_output.h;
#  no DIAGNOSTIC: boot_duration_timer() KASSERTs curcpu_stable() here)
options		LOCKDEBUG
options		KTRACE

# SVR4 IPC: Xorg probes shmget(2) at startup even with MIT-SHM disabled, and
# the stub implementation (option off) raises SIGSYS which X treats as fatal.
options		SYSVSHM
options		SYSVSEM

# Paravirtual clock available on KVM
pvclock* at pv?

# PCI frontends for virtio(4): inert on the virtio-mmio-only microvm,
# but let the same kernel boot under q35 with -device virtio-blk-pci,
# virtio-gpu-pci and virtio-gpu-gl-pci.  A windowed QEMU display exists
# only for the PCI variants (QEMU 8.x sysbus virtio-gpu-device has no
# display console), so this is the config for visual/interactive runs.
virtio*		at pci?	dev ? function ?

# tslog(4) boot-time event tracing facility
#options	TSLOG
