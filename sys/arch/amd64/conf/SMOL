include "arch/amd64/conf/MICROVM"
include "arch/x86/conf/files.tslog"

# debug instrumentation for the vioinput click-wedge investigation
# (no options DDB: this fork's sys/ddb lacks db_output.h;
#  no DIAGNOSTIC: boot_duration_timer() KASSERTs curcpu_stable() here)
options		LOCKDEBUG
options		KTRACE

# SVR4 IPC: Xorg probes shmget(2) at startup even with MIT-SHM disabled, and
# the stub implementation (option off) raises SIGSYS which X treats as fatal.
options		SYSVSHM
options		SYSVSEM

# Paravirtual clock available on KVM
pvclock* at pv?

# QEMU firmware config interface
qemufwcfg*	at pv?

## virtio-input (qemu virtio-keyboard/mouse-device): console input and
## X keyboard/mouse.  Our driver sources need the wscons symbols, so
## every config attaching vioinput must enable wskbd/wsmouse; the kernel
## console stays on com/xen.  viogpu is SMOLX-only (see there).
vioinput*	at virtio?
wskbd*		at vioinput?
wsmouse*	at vioinput?
pseudo-device	wsmux		# wsdisplay sc_input requires it once NWSKBD>0 (SMOLX inherits this)

# tslog(4) boot-time event tracing facility
#options	TSLOG

# Go netpoll (and other NetBSD-10-era binaries) call __kevent50 = syscall 435,
# which on 11.x lives behind COMPAT_100; without it kevent dies with ENOSYS.
options		COMPAT_100		# NetBSD 10.0+ compat (legacy syscall shims)
