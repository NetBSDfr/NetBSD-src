include "arch/amd64/conf/MICROVM"
include "arch/x86/conf/files.tslog"

# debug instrumentation for the vioinput click-wedge investigation
# (no options DDB: this fork's sys/ddb lacks db_output.h;
#  no DIAGNOSTIC: boot_duration_timer() KASSERTs curcpu_stable() here)
options		LOCKDEBUG
options		KTRACE

# SVR4 IPC: Xorg probes shmget(2) at startup even with MIT-SHM disabled, and
# the stub implementation (option off) raises SIGSYS which X treats as fatal.
options		SYSVSHM
options		SYSVSEM

# Paravirtual clock available on KVM
pvclock* at pv?

# QEMU firmware config interface
qemufwcfg*	at pv?

## wscons text console on the 2D virtio-gpu (virtio.config attaches
## viogpu/vioinput unconditionally, and our driver sources need the
## wscons symbols; kernel console stays on com/xen).
## WSDISPLAY_DEFAULTSCREENS=4 because a non-console wsdisplay unit creates
## no virtual screens by default (0), so /dev/ttyE* would all ENXIO and
## X's xf86OpenWScons() probe would fail even though wsdisplay0 attaches.
options		WSDISPLAY_DEFAULTSCREENS=4
wsdisplay*	at viogpu? kbdmux -1

## virtio-input (qemu virtio-keyboard/mouse-device)
wskbd*		at vioinput?
wsmouse*	at vioinput?
pseudo-device	wsmux		# wsdisplay sc_input requires it once NWSKBD>0

# tslog(4) boot-time event tracing facility
#options	TSLOG
