#	$NetBSD$
#
# new style config file for the WebAssembly (wasm32) architecture
# smolBSD project
#

# maxpartitions must be first item in files.${ARCH}.newconf
maxpartitions 16

maxusers 1 2 8

# Device majors (mem/cons/ctty are mandatory; keep complete).
include		"arch/wasm/conf/majors.wasm"

#
# Core machine support.
#
file	dev/cons.c			machdep
file	arch/wasm/wasm/atomic.c
file	arch/wasm/wasm/consinit.c
file	arch/wasm/wasm/cpu.c
file	arch/wasm/wasm/locore.c
file	arch/wasm/wasm/pmap.c
file	arch/wasm/wasm/subr_user.c
file	arch/wasm/wasm/clock.c
file	arch/wasm/wasm/stubs.c
file	arch/wasm/wasm/machdep.c
file	arch/wasm/wasm/lwp_csw.c
file	arch/wasm/wasm/engine_unwind.c
file	arch/wasm/wasm/ptrace.c
file	arch/wasm/wasm/syscall.c

#
# wasm32 userland: binfmt handler plus the programs linked into the
# module (the filesystem holds 32-byte stubs naming them).
#
file	arch/wasm/wasm/exec_wasm32.c
file	arch/wasm/user/init.c

#
# Root filesystem support: dev/md.c is declared by dev/files.dev;
# dev/md_root.c is the MEMORY_DISK_HOOKS glue that points md0 at it.
#
file	dev/md_root.c			memory_disk_hooks
