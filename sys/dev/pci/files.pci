attach	ubsec at pci

# Aironet PC4500/PC4800
attach	an at pci with an_pci

# ADMtek ADM8211 PCI/Mini-PCI
attach	atw at pci with atw_pci

# Realtek RTL8180 PCI/Mini-PCI
attach	rtw at pci with rtw_pci

