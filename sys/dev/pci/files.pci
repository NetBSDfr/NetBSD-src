device	amdpm: i2cbus, acpipmtimer
attach	amdpm at pci

# AMD Cryptographic Coprocessor
attach	amdccp at pci with amdccp_pci

# Hi/fn 7751
device	hifn: opencrypto
attach	hifn at pci

# Bluesteelnet 5501/5601, Broadcom 580x/582x security processor
