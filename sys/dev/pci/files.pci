defflag opt_radeonfb.h	RADEONFB_MMAP_BARS
defflag opt_radeonfb.h	RADEONFB_DEPTH_32
defflag opt_radeonfb.h	RADEONFB_ALWAYS_ACCEL_PUTCHAR

