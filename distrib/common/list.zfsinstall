#	$NetBSD$
#
# list file (c.f. parselist.awk) for ZFS on root.
#

SRCDIRS	external/cddl/osnet/sbin
PROG	sbin/zfs
PROG	sbin/zpool
LINK	sbin/zfs sbin/mount_zfs
ARGVLN	zfs mount_zfs

# We need sysctl to set init.root=/altroot
PROG	sbin/sysctl

# We need modload as we cannot build CDDL modules in the kernel
PROG	sbin/modload
PROG	sbin/modunload
PROG	sbin/modstat

# We need newfs_msdos for EFI
PROG	sbin/newfs_msdos

# We need installboot for NetBSD
PROG	usr/sbin/installboot

# We need bsddialog for the installer
SRCDIRS	external/bsd/bsddialog/usr.bin
PROG	usr/bin/bsddialog

# We need progress for progress bars
PROG	usr/bin/progress

# We need tr and wc for pretty dialogs
PROG	usr/bin/tr
PROG	usr/bin/wc

# We need uname for run-time configuration
PROG	usr/bin/uname

LIBS	-lbsddialog
LIBS	-lcurses
LIBS	-lnvpair
LIBS	-luutil
LIBS	-lzfs
LIBS	-lavl
LIBS	-lm
LIBS	-lpthread
LIBS	-lterminfo
LIBS	-lumem
#LIBS	-lutil		# replaced by libhack
LIBS	-lz
LIBS	-lzfs_core

COPY	${NETBSDSRCDIR}/distrib/common/zfsinstall.rc etc/rc

# Make modules and firmware images available
SYMLINK	altroot/stand stand
SYMLINK	altroot/libdata libdata
