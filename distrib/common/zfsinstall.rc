#!/bin/sh
#
#	$NetBSD$

# Assumption - boot.cfg loads this ramdisk.
# Assumption - network is configurable with any interface over DHCP.
# Assumption - there is enough RAM for /tmp.
# Assumption - the size and partitioning is identical for every disk.
# Assumption - every disk found is active and added to the pool.
# Assumption - pool layout: 1 simple, 2 mirror, 3-4 raidz1, 5-6 raidz2, 7+ raidz3.
# Assumption - the root pool is set to legacy mount.

# Configurable - define the ZFS root pool and ROOT.
# XXX Can these be set in boot.cfg?
rpool=rpool
rroot=ROOT

# Configurable - additional settings.
dldir="/tmp"
ffsver=2
kernel="GENERIC"
kernelext=".gz"
machine=$(/usr/bin/uname -m)
osname=$(/usr/bin/uname -s)
osver=$(/usr/bin/uname -r)
osver=${osver%%_*}
backtitle="$osname root on ZFS installer"
# XXX https is not supported
mirror="http://ftp.NetBSD.org/pub/$osname/$osname-$osver"
modules="solaris zfs"
network=1
progname="zfsinstall"
ramdisk="zfsroot"
ramdiskext=".kmod"
setext=".tar.xz"
sets="base comp etc games gpufw man manhtml misc modules rescue text"
#sets="base etc modules"
verbose=1

# Commands
cmdcp="/bin/cp -v"
cmdftp="/usr/bin/ftp -v"
cmdinstallboot="/usr/sbin/installboot -v"
cmdnewfs="/sbin/newfs -V $verbose"
cmdsysctl="/sbin/sysctl"

if [ -x /usr/bin/bsddialog ]; then
	verbose=0
	cmdcp="/bin/cp"
	cmdftp="/usr/bin/ftp -V"
	cmdinstallboot="/usr/sbin/installboot"
	cmdnewfs="/sbin/newfs -V $verbose"
	cmdsysctl="/sbin/sysctl -q"
fi

# Error messages
errdlkern="could not download kernel:"
errdlramdisk="could not download ramdisk:"
errdlset="could not download set:"
errformat="could not format a disk"
errinstboot="could not install the bootloader"
errinstkern="could not install kernel:"
errinstmodules="could not install the modules"
errinstramdisk="could not install ramdisk:"
errinstset="could not install set:"
errmkdev="could not create a device node"
errmkdir="could not create a directory"
errmount="could not mount a partition"
errnetwork="could not configure the network"
errnodisk="could not detect any usable disk"
errpartition="could not partition disk:"
errtmpfs="could not mount a tmpfs volume"
errumount="could not unmount a partition"
errzfsset="could not set a ZFS property"


# Functions
_abort() {
	[ $# -gt 1 ] && _error "$@"
	exec /bin/sh
}

_download() {
	url="$1"

	[ $network -eq 0 ] || (cd "$dldir" && $cmdftp "$url")
}

_extract_set() {
	destdir="$1"
	set="$2"

	if [ $network -eq 0 ]; then
		_extract "$destdir" "/cdrom/$machine/binary/sets/$set$setext"
	else
		_extract "$destdir" "$dldir/$set$setext"
	fi
}

_error() {
	if [ -x /usr/bin/bsddialog ]; then
		TERM=wsvt25 /usr/bin/bsddialog \
			--backtitle "$backtitle" \
			--title "Error" --msgbox "$@" 21 78
		[ $? -eq 0 ] || echo "$progname: $@" 1>&2
	else
		echo "$progname: $@" 1>&2
	fi
	return 2
}

_extract() {
	destdir="$1"
	archive="$2"

	if [ -x /usr/bin/progress ]; then
		(cd "$destdir" && /usr/bin/progress -zf "$archive" /usr/bin/tar xpf -)
	else
		(cd "$destdir" && /usr/bin/tar xzpf "$archive")
	fi
}

_info() {
	if [ -x /usr/bin/bsddialog ]; then
		TERM=wsvt25 /usr/bin/bsddialog \
			--backtitle "$backtitle" \
			--infobox "$@" 21 78
		[ $? -eq 0 ] || echo "$progname: $@"
	else
		echo "$progname: $@"
	fi
}

_install_kernel() {
	destdir="$1"
	kernel="$2"

	if [ $network -eq 0 ]; then
		$cmdcp "/cdrom/$machine/binary/kernel/netbsd-$kernel$kernelext" \
			"$destdir/netbsd$kernelext"
	else
		$cmdcp "$dldir/netbsd-$kernel$kernelext" \
			"$destdir/netbsd$kernelext"
	fi
}

_install_ramdisk() {
	destdir="$1"
	ramdisk="$2"

	if [ $network -eq 0 ]; then
		$cmdcp "/cdrom/$machine/installation/miniroot/$ramdisk$ramdiskext" \
			"$destdir/$ramdisk$ramdiskext"
	else
		$cmdcp "$dldir/$ramdisk$ramdiskext" \
			"$destdir/$ramdisk$ramdiskext"
	fi
}

_network() {
	_info "Configuring the network"
	/sbin/dhcpcd -q --waitip=4
}


# Setup some stuff in case things go south and we drop to the shell
export HOME=/
export PATH=/sbin:/bin:/usr/sbin:/usr/bin
umask 022

# Mount a few tempfs to allow modifications over the ramdisk contents
mount -t tmpfs -o -m=1777 tmpfs /tmp			|| _abort $errtmpfs
mount -t tmpfs tmpfs /var				|| _abort $errtmpfs
mount -t tmpfs -o union tmpfs /etc			|| _abort $errtmpfs

# Prepare important directories in the tmpfses, so dhcpcd and vi will work
/bin/mkdir -p /var/run /var/db /var/tmp			|| _abort $errmkdir

# Look for bootable media
disknames=$(/sbin/sysctl -n hw.disknames)
for disk in $disknames; do
	case $disk in
		cd*)
			mkdir -p /cdrom			|| _abort $errmkdir
			mount -t cd9660 /dev/${disk}a /cdrom || continue
			if [ -d "/cdrom/$machine/binary/sets" ]; then
				_info "Found the installation media ($disk)"
				network=0
			else
				umount /cdrom
			fi
			;;
	esac
done

if [ $network -ne 0 ]; then
	_network					|| _abort $errnetwork
fi

# Locate the disks
disks=
dkidx=0
sep=
cnt=0
for disk in $disknames; do
	case $disk in
		dk*)
			# XXX assumes growing order
			dkidx=${disk#dk}
			dkidx=$((dkidx + 1))
			;;
		ld*|wd*)
			disks="$disks$sep$disk"
			sep=' '
			cnt=$((cnt + 1))
			;;
	esac
done

pool=
case $cnt in
	0)
		_abort $errnodisk
		;;
	1)
		;;
	2)
		pool="mirror"
		;;
	3|4)
		pool="raidz1"
		;;
	5|6)
		pool="raidz2"
		;;
	*)
		pool="raidz3"
		;;
esac
_info "Detected $cnt disks: $disks"

if [ $network -ne 0 ]; then
	# Download the sets, kernel, and ramdisk to RAM
	for set in $sets; do
		_info "Downloading set: $set"
		seturl="$mirror/$machine/binary/sets/$set$setext"
		_download "$seturl"			|| _abort $errdlset $set
	done
	_info "Downloading kernel: $kernel"
	kernurl="$mirror/$machine/binary/kernel/netbsd-$kernel$kernelext"
	_download "$kernurl"				|| _abort $errdlkern $kernel
	_info "Downloading ramdisk: $ramdisk"
	ramdiskurl="$mirror/$machine/installation/miniroot/$ramdisk$ramdiskext"
	_download "$ramdiskurl"				|| _abort $errdlramdisk $ramdisk
fi

# Partition the disks
vdevs=
sep=
for disk in $disks; do
	_info "Partitioning disk $disk"
	/sbin/gpt create $disk				|| _abort $errpartition $disk
	/sbin/gpt add -a 1m -s 512m -t efi $disk	|| _abort $errpartition $disk
	/sbin/gpt add -a 1m -s 512m -t ffs $disk	|| _abort $errpartition $disk
	/sbin/gpt add -a 1m -t zfs $disk		|| _abort $errpartition $disk
	/sbin/gpt biosboot -i 2 $disk			|| _abort $errpartition $disk

	# Format the partitions
	_info "Formatting partition: dk$dkidx (EFI)"
	/sbin/newfs_msdos /dev/rdk$dkidx		|| _abort $errformat
	_info "Formatting partition: dk$((dkidx + 1)) (FFSv$ffsver)"
	$cmdnewfs -O $ffsver /dev/rdk$((dkidx + 1))	|| _abort $errformat

	# Setup the EFI partition
	_info "Setting up partition: dk$dkidx (EFI)"
	/sbin/mount /dev/dk$dkidx /altroot		|| _abort $errmount
	/bin/mkdir -p /altroot/EFI/boot			|| _abort $errmkdir
	$cmdcp /usr/mdec/bootx64.efi /usr/mdec/bootia32.efi \
		/altroot/EFI/boot			|| _abort $errinstboot
	/sbin/umount /altroot				|| _abort $errumount

	# Setup the NetBSD boot partition
	_info "Setting up partition: dk$((dkidx + 1)) (FFSv$ffsver)"
	/sbin/mount /dev/dk$((dkidx + 1)) /altroot	|| _abort $errmount
	cat > /altroot/boot.cfg << EOF
menu=Boot normally:rndseed /etc/entropy-file;load solaris;load zfs;load /$ramdisk$ramdiskext;boot netbsd$kernelext
menu=Boot single user:rndseed /etc/entropy-file;load solaris;load zfs;load $ramdisk$ramdiskext;boot netbsd$kernelext -s
menu=Drop to boot prompt:prompt
default=1
timeout=5
clear=1
EOF
	_info "Installing kernel: $kernel"
	_install_kernel /altroot "$kernel"		|| _abort $errinstkern $kernel
	_info "Installing ramdisk: $ramdisk"
	_install_ramdisk /altroot "$ramdisk"		|| _abort $errinstramdisk $ramdisk
	_info "Installing modules"
	_extract_set /altroot "modules"			|| _abort $errinstmodules
	_info "Installing bootloader"
	$cmdcp /usr/mdec/boot /altroot/boot		|| _abort $errinstboot
	/sbin/umount /altroot				|| _abort $errumount
	$cmdinstallboot -m "$machine" /dev/dk$((dkidx + 1)) \
		/usr/mdec/bootxx_ffsv$ffsver		|| _abort $errinstboot
	vdevs="$vdevs${sep}dk$((dkidx + 2))"
	sep=' '
	dkidx=$((dkidx + 3))
done

# Create the ZFS pool
_info "Creating ZFS pool: $rpool"
/sbin/zpool create -f "$rpool" $pool $vdevs		|| _abort
_info "Creating ZFS volume: $rpool/$rroot"
/sbin/zfs create "$rpool/$rroot"			|| _abort
/sbin/zfs set mountpoint=legacy "$rpool/$rroot"		|| _abort $errzfsset
_info "Mounting ZFS volume: $rpool/$rroot on /altroot"
/sbin/mount -t zfs "$rpool/$rroot" /altroot		|| _abort $errmount

# Install the sets
for set in $sets; do
	_info "Installing set: $set"
	_extract_set /altroot "$set"			|| _abort $errinstset $set
done

# Configure the system
/bin/mkdir -p /altroot/kern /altroot/proc		|| _abort $errmkdir
cat > /altroot/etc/fstab << EOF
rpool/ROOT / zfs rw
kernfs /kern kernfs rw
ptyfs /dev/pts ptyfs rw
procfs /proc procfs rw
tmpfs /var/shm tmpfs rw,-m1777,-sram%25
EOF
(cd /altroot/dev && ./MAKEDEV all)			|| _abort $errmkdev
cat >> /altroot/etc/rc.conf << EOF
rc_configured=YES

hostname="$(/usr/bin/uname -n)"
zfs=YES

#services
dhcpcd=YES
inetd=NO
sshd=YES
EOF

# Export the ZFS pool
/sbin/umount /altroot					|| _abort $errumount
_info "Exporting ZFS pool: $rpool"
/sbin/zpool export "$rpool"				|| _abort

# Start the system like zfsroot.rc
_info "Importing ZFS pool: $rpool"
/sbin/zpool import -f -N "$rpool"			|| _abort

_info "Mounting ZFS volume: $rpool/$rroot on /altroot"
/sbin/mount -t zfs "$rpool/$rroot" /altroot		|| _abort $errmount

_info "Restarting init"
$cmdsysctl -w init.root=/altroot			|| _abort
